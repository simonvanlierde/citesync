{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["**/*.test.mjs", "**/*.spec.mjs", "playwright.config.mjs"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "performance": { "useTopLevelRegex": "off" }
        }
      }
    }
  ]
}
