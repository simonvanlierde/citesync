   "name": "RO-Crate: a reference is not its entity, so it has no name",
   "path": "@graph[@id=./].author[].name",
   "document": {
    "@context": "https://w3id.org/ro/crate/1.3/context",
    "@graph": [
     {
      "@id": "ro-crate-metadata.json",
      "@type": "CreativeWork",
      "about": {
       "@id": "./"
      }
     },
     {
      "@id": "./",
      "@type": "Dataset",
      "name": "Carberry's lab notes",
      "author": [
       {
        "@id": "https://orcid.org/0000-0002-1825-0097"
       },
       {
        "@id": "#author-2"
       }
      ]
     },
     {
      "@id": "./data/",
      "@type": "Dataset",
      "name": "Raw readings"
     },
     {
      "@id": "https://orcid.org/0000-0002-1825-0097",
      "@type": "Person",
      "name": "Josiah Carberry"
     }
