  {
   "name": "RO-Crate identifier: a PropertyValue with a local @id gives its url, value and @id",
   "path": "@graph[@id=./].identifier[].url + @graph[@id=./].identifier[].value + @graph[@id=./].identifier[].@id + @graph[@id=./].identifier[]",
   "document": {
    "@graph": [
     {
      "@id": "./",
      "@type": "Dataset",
      "identifier": [
       {
        "@id": "#doi",
        "@type": "PropertyValue",
        "propertyID": "https://registry.identifiers.org/registry/doi",
        "value": "doi:10.5555/carberry.notes",
        "url": "https://doi.org/10.5555/carberry.notes"
       }
      ]
     }
    ]
   },
   "expected": [
    "https://doi.org/10.5555/carberry.notes",
    "doi:10.5555/carberry.notes",
    "#doi",
    {
     "@id": "#doi",
     "@type": "PropertyValue",
     "propertyID": "https://registry.identifiers.org/registry/doi",
     "value": "doi:10.5555/carberry.notes",
     "url": "https://doi.org/10.5555/carberry.notes"
    }
   ]
  },
