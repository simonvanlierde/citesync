{
 "schema_version": "1.6",
 "cases": [
  {
   "name": "key",
   "path": "package.name",
   "document": {
    "package": {
     "name": "carberry"
    }
   },
   "expected": [
    "carberry"
   ]
  },
  {
   "name": "key to an object",
   "path": "package",
   "document": {
    "package": {
     "name": "carberry"
    }
   },
   "expected": [
    {
     "name": "carberry"
    }
   ]
  },
  {
   "name": "missing key",
   "path": "package.version",
   "document": {
    "package": {
     "name": "carberry"
    }
   },
   "expected": []
  },
  {
   "name": "missing first key",
   "path": "nothing.here",
   "document": {
    "package": {}
   },
   "expected": []
  },
  {
   "name": "key below a scalar",
   "path": "package.name.first",
   "document": {
    "package": {
     "name": "carberry"
    }
   },
   "expected": []
  },
  {
   "name": "list, each element",
   "path": "authors[]",
   "document": {
    "authors": [
     {
      "name": "Tu Youyou",
      "orcid": "x"
     },
     {
      "name": "Antonie van Leeuwenhoek"
     },
     "loose"
    ]
   },
   "expected": [
    {
     "name": "Tu Youyou",
     "orcid": "x"
    },
    {
     "name": "Antonie van Leeuwenhoek"
    },
    "loose"
   ]
  },
  {
   "name": "list, key of each element, in order",
   "path": "authors[].name",
   "document": {
    "authors": [
     {
      "name": "Tu Youyou",
      "orcid": "x"
     },
     {
      "name": "Antonie van Leeuwenhoek"
     },
     "loose"
    ]
   },
   "expected": [
    "Tu Youyou",
    "Antonie van Leeuwenhoek"
   ]
  },
  {
   "name": "element without the key is skipped",
   "path": "authors[].orcid",
   "document": {
    "authors": [
     {
      "name": "Tu Youyou",
      "orcid": "x"
     },
     {
      "name": "Antonie van Leeuwenhoek"
     },
     "loose"
    ]
   },
   "expected": [
    "x"
   ]
  },
  {
   "name": "[] on a value that is not a list",
   "path": "package[].name",
   "document": {
    "package": {
     "name": "carberry"
    }
   },
   "expected": []
  },
  {
   "name": "[] on an empty list",
   "path": "authors[].name",
   "document": {
    "authors": []
   },
   "expected": []
  },
  {
   "name": "[k=v] keeps every match, in order",
   "path": "identifiers[type=doi].value",
   "document": {
    "identifiers": [
     {
      "type": "url",
      "value": "https://example.org"
     },
     {
      "type": "doi",
      "value": "10.5555/a"
     },
     {
      "type": "doi",
      "value": "10.5555/b"
     },
     "loose"
    ]
   },
   "expected": [
    "10.5555/a",
    "10.5555/b"
   ]
  },
  {
   "name": "[k=v] with no match",
   "path": "identifiers[type=isbn].value",
   "document": {
    "identifiers": [
     {
      "type": "url",
      "value": "https://example.org"
     },
     {
      "type": "doi",
      "value": "10.5555/a"
     },
     {
      "type": "doi",
      "value": "10.5555/b"
     },
     "loose"
    ]
   },
   "expected": []
  },
  {
   "name": "[k=v] with a dot and a hyphen in the value",
   "path": "ids[type=cff-1.2].value",
   "document": {
    "ids": [
     {
      "type": "cff-1.2",
      "value": "v"
     },
     {
      "type": "cff-1",
      "value": "w"
     }
    ]
   },
   "expected": [
    "v"
   ]
  },
  {
   "name": "[k=v] on a number reads it as text",
   "path": "ids[n=2].value",
   "document": {
    "ids": [
     {
      "n": 1,
      "value": "a"
     },
     {
      "n": 2,
      "value": "b"
     }
    ]
   },
   "expected": [
    "b"
   ]
  },
  {
   "name": "[@k=v] filter key",
   "path": "author[@type=Person].name",
   "document": {
    "author": [
     {
      "@type": "Organization",
      "name": "o"
     },
     {
      "@type": "Person",
      "name": "p"
     }
    ]
   },
   "expected": [
    "p"
   ]
  },
  {
   "name": "key starting with @",
   "path": "@id",
   "document": {
    "@id": "https://example.org/x"
   },
   "expected": [
    "https://example.org/x"
   ]
  },
  {
   "name": "@ key after a dot",
   "path": "repository.@url",
   "document": {
    "repository": {
     "@url": "https://example.org/r",
     "url": "no"
    }
   },
   "expected": [
    "https://example.org/r"
   ]
  },
  {
   "name": "@ key below a list",
   "path": "author[].@id",
   "document": {
    "author": [
     {
      "@id": "a"
     },
     {
      "name": "n"
     },
     {
      "@id": "b"
     }
    ]
   },
   "expected": [
    "a",
    "b"
   ]
  },
  {
   "name": "@ inside a key (R Authors@R)",
   "path": "Authors@R",
   "document": {
    "Authors@R": "person(\"Marie\", \"Curie\")"
   },
   "expected": [
    "person(\"Marie\", \"Curie\")"
   ]
  },
  {
   "name": "nested lists are flattened in order",
   "path": "groups[].members[].name",
   "document": {
    "groups": [
     {
      "kind": "core",
      "members": [
       {
        "name": "a"
       },
       {
        "name": "b"
       }
      ]
     },
     {
      "kind": "extra",
      "members": [
       {
        "name": "c"
       }
      ]
     },
     {
      "kind": "core"
     }
    ]
   },
   "expected": [
    "a",
    "b",
    "c"
   ]
  },
  {
   "name": "filter, then a nested list",
   "path": "groups[kind=core].members[].name",
   "document": {
    "groups": [
     {
      "kind": "core",
      "members": [
       {
        "name": "a"
       },
       {
        "name": "b"
       }
      ]
     },
     {
      "kind": "extra",
      "members": [
       {
        "name": "c"
       }
      ]
     },
     {
      "kind": "core"
     }
    ]
   },
   "expected": [
    "a",
    "b"
   ]
  },
  {
   "name": "nested filters",
   "path": "groups[kind=core].members[name=b].name",
   "document": {
    "groups": [
     {
      "kind": "core",
      "members": [
       {
        "name": "a"
       },
       {
        "name": "b"
       }
      ]
     },
     {
      "kind": "extra",
      "members": [
       {
        "name": "c"
       }
      ]
     },
     {
      "kind": "core"
     }
    ]
   },
   "expected": [
    "b"
   ]
  },
  {
   "name": "alternatives: the first that exists wins",
   "path": "urls.Source | urls.Repository | urls.Homepage",
   "document": {
    "urls": {
     "Repository": "https://example.org/r",
     "Homepage": "https://example.org"
    }
   },
   "expected": [
    "https://example.org/r"
   ]
  },
  {
   "name": "alternatives: both exist, only the first is read",
   "path": "urls.Homepage | urls.Repository",
   "document": {
    "urls": {
     "Repository": "https://example.org/r",
     "Homepage": "https://example.org"
    }
   },
   "expected": [
    "https://example.org"
   ]
  },
  {
   "name": "alternatives: none exist",
   "path": "urls.A | urls.B",
   "document": {
    "urls": {
     "Repository": "https://example.org/r",
     "Homepage": "https://example.org"
    }
   },
   "expected": []
  },
  {
   "name": "alternatives: an empty list falls through",
   "path": "empty[] | urls.Homepage",
   "document": {
    "empty": [],
    "urls": {
     "Repository": "https://example.org/r",
     "Homepage": "https://example.org"
    }
   },
   "expected": [
    "https://example.org"
   ]
  },
  {
   "name": "alternatives: a filter with no match falls through",
   "path": "authors[name=nobody].name | urls.Homepage",
   "document": {
    "authors": [
     {
      "name": "Tu Youyou",
      "orcid": "x"
     },
     {
      "name": "Antonie van Leeuwenhoek"
     },
     "loose"
    ],
    "urls": {
     "Repository": "https://example.org/r",
     "Homepage": "https://example.org"
    }
   },
   "expected": [
    "https://example.org"
   ]
  },
  {
   "name": "alternatives: elements without the key fall through",
   "path": "authors[].orcid | urls.Homepage",
   "document": {
    "authors": [
     {
      "name": "n"
     }
    ],
    "urls": {
     "Repository": "https://example.org/r",
     "Homepage": "https://example.org"
    }
   },
   "expected": [
    "https://example.org"
   ]
  },
  {
   "name": "alternatives: the codemeta version row reads version",
   "path": "version | softwareVersion",
   "document": {
    "version": "1.2.0"
   },
   "expected": [
    "1.2.0"
   ]
  },
  {
   "name": "alternatives: the codemeta version row falls back to softwareVersion",
   "path": "version | softwareVersion",
   "document": {
    "softwareVersion": "1.2.0"
   },
   "expected": [
    "1.2.0"
   ]
  },
  {
   "name": "alternatives with @ keys",
   "path": "Authors@R | Maintainer",
   "document": {
    "Maintainer": "m"
   },
   "expected": [
    "m"
   ]
  },
  {
   "name": "[k=v] on a list matches an element whose list holds v",
   "path": "Authors@R[role=aut].given",
   "document": {
    "Authors@R": [
     {
      "given": "Tu",
      "role": [
       "aut",
       "cre"
      ]
     },
     {
      "given": "Antonie",
      "role": [
       "ctb"
      ]
     },
     {
      "given": "Marie",
      "role": "aut"
     }
    ]
   },
   "expected": [
    "Tu",
    "Marie"
   ]
  },
  {
   "name": "[k=v] never matches an element without k",
   "path": "credit[typeRole=None].name",
   "document": {
    "credit": [
     {
      "name": "Tu Youyou"
     }
    ]
   },
   "expected": []
  },
  {
   "name": "+ reads every part, part by part",
   "path": "Author[] + Author-email[]",
   "document": {
    "Author": [
     "Tu Youyou"
    ],
    "Author-email": [
     "Antonie van Leeuwenhoek <antonie@example.org>"
    ]
   },
   "expected": [
    "Tu Youyou",
    "Antonie van Leeuwenhoek <antonie@example.org>"
   ]
  },
  {
   "name": "Author and Author-email are lists: the parser splits the spec's C. Schultz example into four names, a known loss",
   "path": "Author[] + Author-email[]",
   "document": {
    "Author": [
     "C. Schultz",
     "Universal Features Syndicate",
     "Los Angeles",
     "CA"
    ],
    "Author-email": [
     "B <b@example.org>"
    ]
   },
   "expected": [
    "C. Schultz",
    "Universal Features Syndicate",
    "Los Angeles",
    "CA",
    "B <b@example.org>"
   ],
   "raw_input": {
    "format": "pkg-info",
    "text": "Author: C. Schultz, Universal Features Syndicate, Los Angeles, CA\nAuthor-email: B <b@example.org>\n"
   }
  },
  {
   "name": "Author 'Ada Lovelace, Grace Hopper' is split by the parser at commas into two names",
   "path": "Author[]",
   "document": {
    "Author": [
     "Ada Lovelace",
     "Grace Hopper"
    ]
   },
   "expected": [
    "Ada Lovelace",
    "Grace Hopper"
   ],
   "raw_input": {
    "format": "pkg-info",
    "text": "Author: Ada Lovelace, Grace Hopper\n"
   }
  },
  {
   "name": "Author 'Datadog, Inc.' stays one name: the parser keeps a company suffix with the piece before it",
   "path": "Author[]",
   "document": {
    "Author": [
     "Datadog, Inc."
    ]
   },
   "expected": [
    "Datadog, Inc."
   ],
   "raw_input": {
    "format": "pkg-info",
    "text": "Author: Datadog, Inc.\n"
   }
  },
  {
   "name": "Author 'A, B, et al.' is two names: the parser drops an et al. piece",
   "path": "Author[]",
   "document": {
    "Author": [
     "A",
     "B"
    ]
   },
   "expected": [
    "A",
    "B"
   ],
   "raw_input": {
    "format": "pkg-info",
    "text": "Author: A, B, et al.\n"
   }
  },
  {
   "name": "Author '\"Smith, Jane\"' stays one name: the parser does not split inside double quotes",
   "path": "Author[]",
   "document": {
    "Author": [
     "Smith, Jane"
    ]
   },
   "expected": [
    "Smith, Jane"
   ],
   "raw_input": {
    "format": "pkg-info",
    "text": "Author: \"Smith, Jane\"\n"
   }
  },
  {
   "name": "Author-email is split by the parser at commas outside quotes and angle brackets",
   "path": "Author-email[]",
   "document": {
    "Author-email": [
     "\"Smith, Jane\" <jane@example.org>",
     "Ada Lovelace <ada@example.org>"
    ]
   },
   "expected": [
    "\"Smith, Jane\" <jane@example.org>",
    "Ada Lovelace <ada@example.org>"
   ],
   "raw_input": {
    "format": "pkg-info",
    "text": "Author-email: \"Smith, Jane\" <jane@example.org>, Ada Lovelace <ada@example.org>\n"
   }
  },
  {
   "name": "EndNote %K with continuation lines is split into one keyword per line by the parser",
   "path": "K[]",
   "document": {
    "K": [
     "analysis",
     "notes",
     "software"
    ]
   },
   "expected": [
    "analysis",
    "notes",
    "software"
   ]
  },
  {
   "name": "+ with one part missing reads the other",
   "path": "Author[] + Author-email[]",
   "document": {
    "Author-email": [
     "Marie Skłodowska-Curie <marie@example.org>"
    ]
   },
   "expected": [
    "Marie Skłodowska-Curie <marie@example.org>"
   ]
  },
  {
   "name": "+ binds tighter than |: an empty alternative falls through",
   "path": "Author[] + Author-email[] | Maintainer",
   "document": {
    "Maintainer": "Tu Youyou"
   },
   "expected": [
    "Tu Youyou"
   ]
  },
  {
   "name": "RIS tags are keys, and AU and KW are lists",
   "path": "AU[]",
   "document": {
    "TY": "COMP",
    "TI": "Carberry",
    "AU": [
     "Lovelace, Ada",
     "Babbage, Charles"
    ],
    "ET": "1.2.0",
    "KW": [
     "analysis",
     "notes"
    ]
   },
   "expected": [
    "Lovelace, Ada",
    "Babbage, Charles"
   ]
  },
  {
   "name": "RIS keywords repeat",
   "path": "KW[]",
   "document": {
    "KW": [
     "analysis",
     "notes"
    ]
   },
   "expected": [
    "analysis",
    "notes"
   ]
  },
  {
   "name": "RIS AU is a list even with one author",
   "path": "AU[]",
   "document": {
    "TY": "COMP",
    "AU": [
     "Lovelace, Ada"
    ]
   },
   "expected": [
    "Lovelace, Ada"
   ]
  },
  {
   "name": "EndNote tag %7 is the key _7",
   "path": "_7",
   "document": {
    "T": "Carberry",
    "_7": "1.2.0"
   },
   "expected": [
    "1.2.0"
   ]
  },
  {
   "name": "prefixed keys",
   "path": "dcterms:creator[].foaf:name",
   "document": {
    "dcterms:creator": [
     {
      "foaf:name": "Antonie van Leeuwenhoek"
     }
    ]
   },
   "expected": [
    "Antonie van Leeuwenhoek"
   ]
  },
  {
   "name": "PKG-INFO with Source and Home-page resolves one URL",
   "path": "Project-URL[label=source].url | Project-URL[label=repository].url | Home-page",
   "document": {
    "Home-page": "https://example.org/carberry",
    "Project-URL": [
     {
      "label": "documentation",
      "url": "https://example.org/docs"
     },
     {
      "label": "source",
      "url": "https://example.org/carberry.git"
     }
    ]
   },
   "expected": [
    "https://example.org/carberry.git"
   ]
  },
  {
   "name": "RIS authors: AU names, then the older A1 names",
   "path": "AU[] + A1[]",
   "document": {
    "TY": "COMP",
    "A1": [
     "Lovelace, Ada"
    ],
    "AU": [
     "Hopper, Grace"
    ]
   },
   "expected": [
    "Hopper, Grace",
    "Lovelace, Ada"
   ]
  },
  {
   "name": "RIS date: the older Y1 when there is no PY",
   "path": "PY | Y1",
   "document": {
    "TY": "COMP",
    "Y1": "1843/10/01/"
   },
   "expected": [
    "1843/10/01/"
   ]
  }
 ]
}
