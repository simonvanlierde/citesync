  {
   "name": "RO-Crate: an author reference's @id, read without resolving it",
   "path": "@graph[@id=./].author[].@id",
   "document": {
    "@context": "https://w3id.org/ro/crate/1.3/context",
    "@graph": [
     {
      "@id": "ro-crate-metadata.json",
