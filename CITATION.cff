# GitHub reads this for its "Cite this repository" button, and Zenodo when it
# archives a release. Software indexes read codemeta.json, which the citesync hook
# keeps in step with this file.
cff-version: 1.2.0
message: If you use this software, please cite it as below.
title: "citesync"
abstract: "Check that CITATION.cff, codemeta.json, .zenodo.json and the package manifests (pyproject.toml, Cargo.toml, package.json) agree, rewrite them to match one source file, and start a CITATION.cff from them, using the CodeMeta crosswalks"
authors:
  - given-names: "Simon"
    family-names: "van Lierde"
    orcid: "https://orcid.org/0009-0006-6953-909X"
repository-code: "https://github.com/simonvanlierde/citesync"
doi: "10.5281/zenodo.23779706"
license: Apache-2.0
keywords:
  - "citation"
  - "CITATION.cff"
  - "codemeta"
  - "zenodo"
  - "software-metadata"
  - "pre-commit"
