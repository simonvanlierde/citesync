{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "citesync --json",
  "description": "Output of `citesync check|write|config|init|explain|rules --json`. A minor release may add rule ids and optional fields; removing or retyping a field in a versioned report bumps `schema_version` and requires a Breaking entry, in a minor release before 1.0 and a major release from 1.0. A run that couldn't finish (exit 2, 3 or 130) has `errors` and no other body.",
  "type": "object",
  "required": ["schema_version", "tool", "errors"],
  "if": { "properties": { "errors": { "maxItems": 0 } } },
  "then": {
    "anyOf": [
      { "required": ["summary", "findings"] },
      { "required": ["root", "origin", "config"] },
      { "required": ["written", "skipped", "name_splits", "notes"] },
      { "required": ["rule"] },
      { "required": ["rules"] }
    ]
  },
  "properties": {
    "schema_version": { "const": 1 },
    "errors": {
      "description": "Why the run couldn't finish; empty when it did. The text output prints each as a `citesync:` line on stderr.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message", "help"],
        "properties": {
          "message": { "type": "string" },
          "help": { "type": ["string", "null"], "description": "What to do about it; null when there is no known next step." }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "citesync" },
        "version": { "type": "string" }
      }
    },
    "summary": {
      "description": "Counts after `ignore`. `files` is the number of files checked.",
      "type": "object",
      "required": ["files", "errors", "warnings", "info"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "root": { "type": "string", "description": "`config`: the repo root in use." },
    "origin": { "type": "string", "description": "`config`: where the settings came from, a file or `defaults`." },
    "config": {
      "description": "`config`: the settings under their config keys, null where unset.",
      "type": "object",
      "required": ["source", "write-manifests", "exports", "required-fields", "fill-missing", "ignore"]
    },
    "written": { "const": "CITATION.cff", "description": "`init`: the file it wrote." },
    "skipped": {
      "description": "`init`: each term left out, with the reason.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "reason"],
        "properties": { "term": { "type": "string" }, "reason": { "type": "string" } }
      }
    },
    "name_splits": {
      "description": "`init`: each one-string author name it split into given and family names, to check.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "given", "family"],
        "properties": { "name": { "type": "string" }, "given": { "type": "string" }, "family": { "type": "string" } }
      }
    },
    "notes": { "description": "`init`: other things to check.", "type": "array", "items": { "type": "string" } },
    "rule": {
      "description": "`explain`: one rule.",
      "type": "object",
      "required": ["rule", "severity", "summary", "details", "help", "url"],
      "properties": {
        "rule": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "help": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "rules": {
      "description": "`rules`: every rule, in the order `citesync rules` prints them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "severity", "summary", "url"],
        "properties": {
          "rule": { "type": "string" },
          "severity": { "enum": ["error", "warning", "info"] },
          "summary": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "findings": {
      "description": "Sorted by file, rule and term. Any error makes the exit code 1; info never changes it.",
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "position": { "type": ["integer", "null"], "minimum": 1 },
    "finding": {
      "type": "object",
      "required": ["rule", "severity", "file", "term", "message", "help", "url", "line", "column"],
      "properties": {
        "rule": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$",
          "description": "A rule id from `citesync rules`; a minor release may add more."
        },
        "severity": { "enum": ["error", "warning", "info"] },
        "file": {
          "type": ["string", "null"],
          "description": "Relative to the repo root; null for a not-checked field no file holds."
        },
        "term": {
          "type": ["string", "null"],
          "description": "A CodeMeta term, or the JSON-LD keyword @context or @type; the file's own key path for unknown-term and foreign-term; null for unreadable, file-missing, manifest-skipped and export-stale."
        },
        "message": { "type": "string" },
        "help": { "type": "string", "description": "What to do about it." },
        "url": { "type": "string", "format": "uri", "description": "The rule's section of docs/rules.md." },
        "line": { "$ref": "#/$defs/position" },
        "column": { "$ref": "#/$defs/position" }
      }
    }
  }
}
