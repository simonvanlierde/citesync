{
  "open_questions": [
    "Is an explicitly listed manifest that is `private: true` still checked? Not exercised here: src/core/package.json is not private."
  ],
  "settled": [
    "2026-10-29: a `manifests` config replaces the default root-manifest list."
  ],
  "cases": [
    {
      "name": "defaults",
      "config": {},
      "exit": 1,
      "findings": [
        {
          "rule": "zenodo-drops-field",
          "file": "CITATION.cff",
          "term": "references",
          "why": "no .zenodo.json, and Zenodo leaves CFF references out of the record",
          "line": 31,
          "column": 1
        },
        {
          "rule": "name-mismatch",
          "file": "codemeta.json",
          "term": "name",
          "why": "codemeta name 'CRediT Matrix' differs from CFF title 'CRediT Matrix: drafting CRediT contribution statements with co-authors'",
          "line": 4,
          "column": 3
        }
      ],
      "info": [
        {
          "rule": "manifest-skipped",
          "file": "package.json",
          "term": null,
          "why": "\"private\": true, so it is never published"
        },
        {
          "rule": "not-checked",
          "file": null,
          "term": "contributor",
          "why": "no file holds a contributor"
        },
        {
          "rule": "not-checked",
          "file": null,
          "term": "swhid",
          "why": "no file holds a value"
        }
      ]
    },
    {
      "name": "npm-core-package",
      "config": {
        "manifests": [
          "src/core/package.json"
        ]
      },
      "exit": 1,
