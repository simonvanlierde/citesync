{
  "name": "credit-matrix-app",
  "version": "0.8.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter credit-matrix build && next build && node scripts/postbuild.mjs",
    "start": "wrangler dev",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p src/core/tsconfig.cli.json",
    "verify": "pnpm --filter credit-matrix build && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:jats": "bash scripts/validate-jats.sh",
    "clean": "rm -rf .next out",
    "version": "bash scripts/sync-citation.sh",
    "prepare": "lefthook install || true",
    "mutation": "stryker run && node scripts/mutation-baseline.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "use-intl": "^4.14.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.16",
    "marked": "18.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "xslt3": "2.7.0",
    "yaml": "2.9.1"
  }
}
