# One ignore file for every stack in this repo.

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
coverage.xml

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
coverage/

# Rust
target/

# mutmut working copy
mutants/

# Profiles (just profile)
profile/

# Browser build and test artifacts
playground/wheels/
playground/runtime.json
playground/lookup.json
playwright-report/
test-results/

# Versioned playground deployment bundle
/site/
